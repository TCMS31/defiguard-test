# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API (server/) ---------------------------------------------------------

# Port the Express API listens on. Prefer API_PORT: `npm start` runs the React
# dev server in the same shell and react-scripts also reads PORT.
API_PORT=3003

# MongoDB connection string. Leave unset to run with in-memory storage: the API
# still boots and answers every route, but nothing persists across a restart.
# MONGO_URL=mongodb://localhost:27017/defiguard

# Secret used to sign JWTs. There is no default on purpose -- without it the
# authenticated routes answer 503 rather than signing with a guessable key.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token lifetime, in the format jsonwebtoken accepts.
JWT_EXPIRES_IN=1d

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# bcrypt work factor.
BCRYPT_ROUNDS=10

# --- Web (src/) ------------------------------------------------------------
# The wallet talks to whatever chain the user's MetaMask is connected to, so it
# needs no RPC URL of its own and holds no key material.
