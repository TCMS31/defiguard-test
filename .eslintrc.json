{
  "root": true,
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "info",
          "warn",
          "error"
        ]
      }
    ],
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": [
        "server/**/*.js",
        "jest.server.config.js"
      ],
      "env": {
        "node": true,
        "es2022": true,
        "jest": true
      },
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "script"
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "src/lib/wallet/testing/**/*.js",
        "**/__tests__/**/*.js",
        "**/*.test.js"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "env": {
    "browser": true,
    "es2020": true
  }
}
